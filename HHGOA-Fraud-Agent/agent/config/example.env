# Agent Environment Configuration Template
# Hacker House Goa 2026 - HHGOA_IEEE Fraud Investigation Agent

# TigerGraph MCP Endpoint (from Phase 4)
TG_HOST=https://your-instance.i.tgcloud.io
TG_GRAPHNAME=FraudInvestigationGraph
TG_USERNAME=tigergraph
TG_PASSWORD=your_password
TG_SECRET=your_secret
TG_TOKEN=your_api_token
TG_RESTPP_PORT=443

# Security Filtering
TG_ALLOWED_TOOLS=query,read-only
TG_BLOCKED_TOOLS=destructive

# Optional LLM Provider Configuration
LLM_PROVIDER=mock
LLM_MODEL=mock-agent-v1
LLM_API_KEY=
