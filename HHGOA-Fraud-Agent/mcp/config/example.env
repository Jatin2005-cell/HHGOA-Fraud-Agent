# ==============================================================================
# TigerGraph MCP Configuration
# HHGOA_IEEE Fraud Investigation Agent
# ==============================================================================

# TigerGraph Instance Endpoint (Savanna Cloud or Community Edition)
# Example for Savanna: https://fraud-agent.i.tgcloud.io
# Example for Local/CE: http://localhost or http://127.0.0.1
TG_HOST=https://your-tigergraph-instance.i.tgcloud.io

# Active Graph Name (Phase 2 & Phase 3 Graph)
TG_GRAPHNAME=FraudInvestigationGraph

# Authentication Credentials (Leave blank if using Token authentication)
TG_USERNAME=tigergraph
TG_PASSWORD=your_tigergraph_password

# Authentication Token or Secret (Required for Cloud/Savanna instances)
TG_SECRET=your_tigergraph_secret_string
TG_TOKEN=your_tigergraph_api_token

# REST++ Port (Default: 9000 for CE, 443 for Savanna Cloud)
TG_RESTPP_PORT=443

# Security & Permissions (Read-Only Enforcement)
# Allowed tool categories: query, read-only
# Blocked tool categories: destructive
TG_ALLOWED_TOOLS=query,read-only
TG_BLOCKED_TOOLS=destructive

# Standard Environment Variable Aliases (Supported by pyTigerGraph)
TIGERGRAPH_HOST=https://your-tigergraph-instance.i.tgcloud.io
TIGERGRAPH_GRAPH=FraudInvestigationGraph
TIGERGRAPH_USERNAME=tigergraph
TIGERGRAPH_PASSWORD=your_tigergraph_password
TIGERGRAPH_API_TOKEN=your_tigergraph_api_token
